VITE_API_URL=
VITE_ADMIN_URL=http://localhost:5174
VITE_STORE_URL=http://localhost:5173

# Backend-only values. Never prefix these with VITE_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Local-only source credentials used by npm run migrate:supabase.
SOURCE_SUPABASE_URL=https://your-project.supabase.co
SOURCE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used once by npm run create:admin; choose a unique password of at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
